# screenpipe — AI that knows everything you've seen, said, or heard
# https://screenpipe.com
# Optional. Sample mode needs no keys. Keep this file's copy at .env private.
SCREENPIPE_LOCAL_API_URL=http://localhost:3030
SCREENPIPE_LOCAL_API_KEY=
# Only used with an explicit --ai flag. That sends the selected context to this provider.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
